local whitelist = {
    ["DBC_STOCK22"] = true,
    ["DBC_STOCK23"] = true,
    ["DBC_STOCK24"] = true,
    ["DBC_STOCK25"] = true,
    ["Soko_Fan1"] = true,
    ["DBC_BR1"] = true,
    ["DBC_BR2"] = true,
    ["DBC_BR3"] = true,
    ["DBC_BR4"] = true,
    ["DBC_BR5"] = true
}

local function checkPlayers()
    local players = game.Players:GetPlayers()
    
    for _, player in ipairs(players) do
        if not whitelist[player.Name] then
            game.Players.LocalPlayer:Kick("Joined a public server (Unlisted player: " .. player.Name .. "). Use yuumy or android manager to reconnect automatically on the private server!")
            return
        end
    end
end

checkPlayers()

game.Players.PlayerAdded:Connect(checkPlayers)

spawn(function()
    while true do
        wait(10)
        checkPlayers()
    end
end)

